# Server
PORT=3001
NODE_ENV=development

# Database - Supabase PostgreSQL
# Supabase 대시보드 > Settings > Database > Connection string > Supavisor (Session mode) 사용
# 1. Connection string에서 [DB-USER]를 prisma로 변경
# 2. [PRISMA-PASSWORD]를 Supabase에서 생성한 Prisma 전용 비밀번호로 변경
# 형식: postgres://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[DB-REGION].pooler.supabase.com:5432/postgres?pgbouncer=true
DATABASE_URL="postgres://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[DB-REGION].pooler.supabase.com:5432/postgres?pgbouncer=true"


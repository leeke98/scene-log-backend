# Server
PORT=3001
NODE_ENV=development

# Database - Supabase PostgreSQL
# Supabase 대시보드 > Settings > Database > Connection string > Supavisor (Session mode) 사용
# 1. Connection string에서 [DB-USER]를 prisma로 변경
# 2. [PRISMA-PASSWORD]를 Supabase에서 생성한 Prisma 전용 비밀번호로 변경
# 형식: postgres://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[DB-REGION].pooler.supabase.com:5432/postgres?pgbouncer=true
# 런타임 쿼리용 (pgbouncer connection pool 사용)
DATABASE_URL="postgres://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[DB-REGION].pooler.supabase.com:5432/postgres?pgbouncer=true"

# 마이그레이션/스키마 변경용 (direct connection, pgbouncer 우회)
DIRECT_URL="postgres://prisma.[PROJECT-REF]:[PRISMA-PASSWORD]@[DB-REGION].pooler.supabase.com:5432/postgres"

# JWT - Access Token (단기 만료)
JWT_SECRET="your-secret-key"
JWT_EXPIRES_IN="15m"

# JWT - Refresh Token (장기 만료, httpOnly 쿠키로 전송)
REFRESH_TOKEN_SECRET="your-refresh-secret-key"
REFRESH_TOKEN_EXPIRES_IN="7d"


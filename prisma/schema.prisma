// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 장르 Enum
enum Genre {
  THEATER // 연극
  MUSICAL // 뮤지컬
}

// 재관람 혜택 유형 Enum
enum RewatchRewardType {
  DISCOUNT_VOUCHER
  MERCHANDISE
}

// 배우 상태 Enum
enum ActorStatus {
  unverified
  verified
  merged
}

// 배우 도메인 Enum
enum ActorDomain {
  MUSICAL // 뮤지컬
  THEATER // 연극
  CLASSIC // 클래식
  OTHER   // 기타
}

// 사용자 테이블
model User {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String?
  nickname   String
  provider   String   @default("local")
  providerId String?  @map("provider_id")
  email      String?
  isAdmin    Boolean  @default(false) @map("is_admin")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tickets              Ticket[]
  refreshTokens        RefreshToken[]
  createdActors        Actor[]
  actorReports         ActorReport[]
  performanceMarks     UserPerformanceMark[]
  rewatchSeasons       RewatchSeason[]

  @@index([username], name: "idx_username")
  @@index([provider, providerId], name: "idx_provider")
  @@map("users")
}

// 리프레시 토큰 테이블
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_token_user_id")
  @@map("refresh_tokens")
}

// 티켓 테이블
model Ticket {
  id              String   @id
  userId          String   @map("user_id")
  date            DateTime @db.Date
  time            DateTime @db.Time
  performanceName String   @map("performance_name")
  genre           Genre?
  isChild         Boolean  @default(false) @map("is_child")
  theater         String
  seat            String?
  ticketPrice     Int      @default(0) @map("ticket_price")
  companion       String?
  mdPrice         Int      @default(0) @map("md_price")
  rating          Int      @default(0)
  review          String?  @db.Text
  posterUrl       String?  @map("poster_url")
  isLinked        Boolean  @default(false) @map("is_linked")
  kopisId         String?  @map("kopis_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketActors TicketActor[]
  cardTickets  RewatchCardTicket[]
  voucherUsages RewatchVoucherUsage[]

  @@index([userId], name: "idx_user_id")
  @@index([date], name: "idx_date")
  @@index([performanceName], name: "idx_performance_name")
  @@index([genre], name: "idx_genre")
  @@index([theater], name: "idx_theater")
  @@index([rating], name: "idx_rating")
  @@map("tickets")
}

// 배우 테이블
model Actor {
  id          String      @id @default(uuid())
  name        String
  birthYear   Int?        @map("birth_year")
  domain      ActorDomain?
  status      ActorStatus @default(unverified)
  canonicalId String?     @map("canonical_id")
  createdBy   String      @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  canonical     Actor?        @relation("ActorMerge", fields: [canonicalId], references: [id])
  mergedActors  Actor[]       @relation("ActorMerge")
  createdByUser User          @relation(fields: [createdBy], references: [id])
  ticketActors  TicketActor[]
  reports       ActorReport[]

  @@index([name], name: "idx_actors_name")
  @@index([status], name: "idx_actors_status")
  @@map("actors")
}

// 티켓-배우 연결 테이블
model TicketActor {
  ticketId String @map("ticket_id")
  actorId  String @map("actor_id")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  Actor  @relation(fields: [actorId], references: [id])

  @@id([ticketId, actorId])
  @@map("ticket_actors")
}

// 위시리스트 테이블
model UserPerformanceMark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  kopisId   String   @map("kopis_id")
  title     String
  posterUrl String?  @map("poster_url")
  startDate String?  @map("start_date")
  endDate   String?  @map("end_date")
  venue     String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kopisId])
  @@index([userId], name: "idx_marks_user_id")
  @@map("user_performance_marks")
}

// 배우 신고 테이블
model ActorReport {
  id               String   @id @default(uuid())
  actorId          String   @map("actor_id")
  reportedBy       String   @map("reported_by")
  reason           String
  duplicateActorId String?  @map("duplicate_actor_id")
  createdAt        DateTime @default(now()) @map("created_at")

  actor    Actor @relation(fields: [actorId], references: [id])
  reporter User  @relation(fields: [reportedBy], references: [id])

  @@map("actor_reports")
}

// 재관람카드 - 공연 시즌 (KOPIS mt20id 기준)
model RewatchSeason {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  mt20id    String   @map("mt20id")
  title     String
  posterUrl String?  @map("poster_url")
  startDate String?  @map("start_date")
  endDate   String?  @map("end_date")
  venue     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones RewatchMilestone[]
  cards      RewatchCard[]

  @@unique([userId, mt20id])
  @@index([userId], name: "idx_rewatch_season_user_id")
  @@map("rewatch_seasons")
}

// 재관람카드 - 마일스톤 규칙 (시즌 당 N개, 한 번 설정)
model RewatchMilestone {
  id              String            @id @default(uuid())
  seasonId        String            @map("season_id")
  stampCount      Int               @map("stamp_count")
  rewardType      RewatchRewardType @map("reward_type")
  discountPercent Int?              @map("discount_percent")
  voucherQty      Int?              @default(1) @map("voucher_qty")
  merchandiseDesc String?           @map("merchandise_desc")
  createdAt       DateTime          @default(now()) @map("created_at")

  season              RewatchSeason              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  voucherUsages       RewatchVoucherUsage[]
  merchandiseReceipts RewatchMerchandiseReceipt[]

  @@index([seasonId], name: "idx_rewatch_milestone_season_id")
  @@map("rewatch_milestones")
}

// 재관람카드 - 카드 인스턴스 (시즌 당 여러 개 가능)
model RewatchCard {
  id        String   @id @default(uuid())
  seasonId  String   @map("season_id")
  label     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  season              RewatchSeason              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  cardTickets         RewatchCardTicket[]
  voucherUsages       RewatchVoucherUsage[]
  merchandiseReceipts RewatchMerchandiseReceipt[]

  @@index([seasonId], name: "idx_rewatch_card_season_id")
  @@map("rewatch_cards")
}

// 재관람카드 - 카드↔티켓 연결 (도장 수 오버라이드)
model RewatchCardTicket {
  id         String   @id @default(uuid())
  cardId     String   @map("card_id")
  ticketId   String   @map("ticket_id")
  stampCount Int      @default(1) @map("stamp_count")
  addedAt    DateTime @default(now()) @map("added_at")

  card   RewatchCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  ticket Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([cardId, ticketId])
  @@index([cardId], name: "idx_rewatch_card_ticket_card_id")
  @@map("rewatch_card_tickets")
}

// 재관람카드 - 할인권 사용 이력
// 잔여 장 수 = milestone.voucherQty - COUNT(milestoneId + cardId)
model RewatchVoucherUsage {
  id          String   @id @default(uuid())
  milestoneId String   @map("milestone_id")
  cardId      String   @map("card_id")
  ticketId    String   @map("ticket_id")
  usedAt      DateTime @default(now()) @map("used_at")

  milestone RewatchMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  card      RewatchCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  ticket    Ticket           @relation(fields: [ticketId], references: [id])

  @@index([milestoneId, cardId], name: "idx_rewatch_voucher_usage")
  @@map("rewatch_voucher_usages")
}

// 재관람카드 - 굿즈 수령 여부 (카드 인스턴스 × 마일스톤)
model RewatchMerchandiseReceipt {
  id          String    @id @default(uuid())
  milestoneId String    @map("milestone_id")
  cardId      String    @map("card_id")
  received    Boolean   @default(false)
  receivedAt  DateTime? @map("received_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  milestone RewatchMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  card      RewatchCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, cardId])
  @@map("rewatch_merchandise_receipts")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 장르 Enum
enum Genre {
  THEATER // 연극
  MUSICAL // 뮤지컬
}

// 배우 상태 Enum
enum ActorStatus {
  unverified
  verified
  merged
}

// 배우 도메인 Enum
enum ActorDomain {
  MUSICAL // 뮤지컬
  THEATER // 연극
  CLASSIC // 클래식
  OTHER   // 기타
}

// 사용자 테이블
model User {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String?
  nickname   String
  provider   String   @default("local")
  providerId String?  @map("provider_id")
  email      String?
  isAdmin    Boolean  @default(false) @map("is_admin")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tickets       Ticket[]
  refreshTokens RefreshToken[]
  createdActors Actor[]
  actorReports  ActorReport[]

  @@index([username], name: "idx_username")
  @@index([provider, providerId], name: "idx_provider")
  @@map("users")
}

// 리프레시 토큰 테이블
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_token_user_id")
  @@map("refresh_tokens")
}

// 티켓 테이블
model Ticket {
  id              String   @id
  userId          String   @map("user_id")
  date            DateTime @db.Date
  time            DateTime @db.Time
  performanceName String   @map("performance_name")
  genre           Genre?
  isChild         Boolean  @default(false) @map("is_child")
  theater         String
  seat            String?
  ticketPrice     Int      @default(0) @map("ticket_price")
  companion       String?
  mdPrice         Int      @default(0) @map("md_price")
  rating          Int      @default(0)
  review          String?  @db.Text
  posterUrl       String?  @map("poster_url")
  isLinked        Boolean  @default(false) @map("is_linked")
  kopisId         String?  @map("kopis_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketActors TicketActor[]

  @@index([userId], name: "idx_user_id")
  @@index([date], name: "idx_date")
  @@index([performanceName], name: "idx_performance_name")
  @@index([genre], name: "idx_genre")
  @@index([theater], name: "idx_theater")
  @@index([rating], name: "idx_rating")
  @@map("tickets")
}

// 배우 테이블
model Actor {
  id          String      @id @default(uuid())
  name        String
  birthYear   Int?        @map("birth_year")
  domain      ActorDomain?
  status      ActorStatus @default(unverified)
  canonicalId String?     @map("canonical_id")
  createdBy   String      @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  canonical     Actor?        @relation("ActorMerge", fields: [canonicalId], references: [id])
  mergedActors  Actor[]       @relation("ActorMerge")
  createdByUser User          @relation(fields: [createdBy], references: [id])
  ticketActors  TicketActor[]
  reports       ActorReport[]

  @@index([name], name: "idx_actors_name")
  @@index([status], name: "idx_actors_status")
  @@map("actors")
}

// 티켓-배우 연결 테이블
model TicketActor {
  ticketId String @map("ticket_id")
  actorId  String @map("actor_id")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  Actor  @relation(fields: [actorId], references: [id])

  @@id([ticketId, actorId])
  @@map("ticket_actors")
}

// 배우 신고 테이블
model ActorReport {
  id               String   @id @default(uuid())
  actorId          String   @map("actor_id")
  reportedBy       String   @map("reported_by")
  reason           String
  duplicateActorId String?  @map("duplicate_actor_id")
  createdAt        DateTime @default(now()) @map("created_at")

  actor    Actor @relation(fields: [actorId], references: [id])
  reporter User  @relation(fields: [reportedBy], references: [id])

  @@map("actor_reports")
}
